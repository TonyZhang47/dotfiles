{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "   ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "#93a1b8",
      "title": "#a1a9b8",
      "output": "#a1a9b8",
      "separator": "#8493ae"
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logos/logo.txt",
    "padding": {
      "top": 1,
      "left": 3,
      "right": 8
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
