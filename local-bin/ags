#!/usr/bin/env bash
# Prefer distro AGS. Fall back to the extracted prefix if needed.
set -euo pipefail
PREFIX="${AGS_PREFIX:-$HOME/.local/opt/ags}"

if [ -x /usr/bin/ags ] && [ -d /usr/share/ags/js ]; then
    BIN=/usr/bin/ags
    SASS="${SASS:-$(command -v sass || true)}"
else
    BIN="$PREFIX/usr/bin/ags"
    SASS="$PREFIX/usr/bin/sass"
    export PATH="$PREFIX/usr/bin:$HOME/.local/bin:${PATH:-}"
    export LD_LIBRARY_PATH="$PREFIX/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export GI_TYPELIB_PATH="$PREFIX/usr/lib/girepository-1.0:$PREFIX/usr/lib/gjs/girepository-1.0:/usr/lib/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
    export XDG_DATA_DIRS="$PREFIX/usr/share:${XDG_DATA_DIRS:-/usr/share}"
    if [ -e "$PREFIX/usr/lib/libgtk4-layer-shell.so" ]; then
        export LD_PRELOAD="$PREFIX/usr/lib/libgtk4-layer-shell.so${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
fi

if [ ! -x "${BIN:-}" ]; then
    echo "ags is not installed" >&2
    exit 1
fi

if [ "${1:-}" = run ] && [ -n "${SASS:-}" ] && [ -x "$SASS" ] && [ -f "$HOME/.config/ags/style.scss" ]; then
    "$SASS" "$HOME/.config/ags/style.scss" "$HOME/.config/ags/style.css" >/dev/null || true
fi

exec "$BIN" "$@"
